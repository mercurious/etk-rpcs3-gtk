 )
 
+# ARMSX3: the Oboe audio backend is Android-only. Its headers come from
+# 3rdparty::oboe, which is linked only on Android (see the link block below),
+# so listing the source unconditionally breaks every non-Android build at
+# dependency scanning ('oboe/Oboe.h' file not found) -- found by the first
+# Linux build of this tree. The backend is only ever constructed from the
+# Android bridge; no code under rpcs3/ references it, so a desktop build
+# loses nothing by never parsing it.
+if(ANDROID)
+    target_sources(rpcs3_emu PRIVATE
+        Audio/Oboe/OboeBackend.cpp
+    )
+endif()
+
