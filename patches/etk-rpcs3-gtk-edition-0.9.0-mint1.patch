diff --git a/rpcs3/Emu/Cell/SPUOpcodes.h b/rpcs3/Emu/Cell/SPUOpcodes.h
index 42d76792a..52b60f1a7 100644
--- a/rpcs3/Emu/Cell/SPUOpcodes.h
+++ b/rpcs3/Emu/Cell/SPUOpcodes.h
@@ -1,5 +1,13 @@
 #pragma once
 
+// X11's X.h defines CWX (a ConfigureWindow value mask) as a bare macro, which
+// clobbers the SPU opcode name of the same spelling in any desktop TU that saw
+// X headers before this one -- the perf overlay does, via the display chain
+// under HAVE_X11, since it reads SPU state through SPUThread.h. Android never
+// meets X11, which is why this only surfaces on a Linux build. #undef of an
+// undefined macro is well-formed, so this costs nothing everywhere else.
+#undef CWX
+
