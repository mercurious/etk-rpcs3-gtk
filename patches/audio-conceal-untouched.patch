diff --git a/rpcs3/Emu/Cell/Modules/etk_audio_conceal.h b/rpcs3/Emu/Cell/Modules/etk_audio_conceal.h
new file mode 100644
index 0000000..ea62cd4
--- /dev/null
+++ b/rpcs3/Emu/Cell/Modules/etk_audio_conceal.h
@@ -0,0 +1,97 @@
+#pragma once
+
+// =========================================================================
+// ETK GTK Edition -- cellAudio untouched-period concealment (GTK_AUDIO_CONCEAL)
+//
+// A game that fills its audio once per rendered frame leaves a 5.33 ms period
+// unwritten for every frame it misses below its native rate. Stock cellAudio
+// ships each one as silence: a hard gate, tens of times a second on a slow
+// title (GT HD Concept on the SM8250, car12 2026-10-27: sil ~40/s at ~50 fps
+// on a 60 fps game, zero underruns, zero drops) -- a buzz riding the engine
+// note that the operator hears as "crunch". The silence also keeps the ring
+// full, so time stretching never engages.
+//
+// This header is the arithmetic only, with no RPCS3 dependencies, so a host
+// test can pin it (etk-rpcs3-gtk: hwtest/test_audio_conceal.cpp). The
+// ringbuffer owns the state and decides when to call it (cellAudio.cpp).
+//
+// Concealment: the unwritten period is filled from the last block the game
+// DID write, ping-pong -- reversed on the first concealed block (so its first
+// sample equals the last sample already shipped), forward on the next, and so
+// on: every junction inside a run is sample-continuous and the block keeps the
+// spectrum of the signal it stands in for. A run is capped (run_max blocks):
+// the last block of a run fades linearly to silence and everything past the
+// cap is silence, so a game that has genuinely stopped writing (loading, a
+// stall) goes quiet instead of buzzing a frozen block forever. When real audio
+// resumes after a run, ramp_resume() removes the step between the last sample
+// shipped and the first real one with a short linear offset ramp (no dip, no
+// gain change). GTK_AUDIO_CONCEAL=0 restores stock silence exactly.
+// =========================================================================
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+namespace etk_audio_conceal
+{
+	// Length of the offset ramp applied to the first real block after a run (frames; 1.33 ms at 48 kHz)
+	constexpr uint32_t RESUME_RAMP_FRAMES = 64;
+
+	// Fill one block (frames x channels, interleaved) standing in for a period the game never wrote.
+	// src is the last real block (same geometry). run = concealed blocks already shipped in this run
+	// (0 = first). Returns true when the block carries signal, false when it is silence (run >= run_max).
+	inline bool fill(float* dst, const float* src, uint32_t frames, uint32_t channels, uint32_t run, uint32_t run_max)
+	{
+		const uint32_t n = frames * channels;
+
+		if (run >= run_max || frames == 0 || channels == 0)
+		{
+			std::memset(dst, 0, n * sizeof(float));
+			return false;
+		}
+
+		const bool reversed = (run % 2) == 0;
+
+		for (uint32_t f = 0; f < frames; f++)
+		{
+			const uint32_t sf = reversed ? (frames - 1 - f) : f;
+			std::memcpy(dst + f * channels, src + sf * channels, channels * sizeof(float));
+		}
+
+		if (run + 1 == run_max)
+		{
+			// Last block the cap allows: fade to silence so the hand-over to the zeros that
+			// follow is not itself a step.
+			for (uint32_t f = 0; f < frames; f++)
+			{
+				const float g = 1.0f - static_cast<float>(f + 1) / static_cast<float>(frames);
+				float* row = dst + f * channels;
+				for (uint32_t c = 0; c < channels; c++) row[c] *= g;
+			}
+		}
+
+		return true;
+	}
+
+	// Real audio resumes after a concealed run: prev_tail[c] is the last sample shipped on channel c.
+	// Adds a linear offset ramp so buf's first frame lands (almost) on prev_tail and the correction
+	// has died out RESUME_RAMP_FRAMES later. In place, no gain change, no dip.
+	inline void ramp_resume(float* buf, const float* prev_tail, uint32_t frames, uint32_t channels)
+	{
+		const uint32_t len = std::min(frames, RESUME_RAMP_FRAMES);
+
+		if (len == 0) return;
+
+		for (uint32_t c = 0; c < channels; c++)
+		{
+			const float delta = prev_tail[c] - buf[c];
+
+			if (delta == 0.0f) continue;
+
+			for (uint32_t f = 0; f < len; f++)
+			{
+				buf[f * channels + c] += delta * (1.0f - static_cast<float>(f + 1) / static_cast<float>(len));
+			}
+		}
+	}
+}
