+// ETK GTK Pitlink EYES -----------------------------------------------------------------------
+//
+// One downscale blit + one image->buffer copy, recorded into the command buffer that carries
+// this frame. No fence is polled and nothing is flushed here: the copy is read back in
+// frame_context_cleanup, after the swap wait the frame pays anyway (on this driver even a
+// fence poke blocks -- see advance_queued_frames). Three ring slots; when all three are still
+// in flight the frame is skipped, because vision wants the newest frame, not a backlog.
+bool VKGSRender::pitlink_record_tap(vk::image* src, u32 region_w, u32 region_h, pitlink::frame_ticket& ticket)
+{
+	pitlink_tap_slot* slot = nullptr;
+	for (auto& candidate : m_pitlink_slots)
+	{
+		if (!candidate.busy)
+		{
+			slot = &candidate;
+			break;
+		}
+	}
+
+	if (!slot)
+	{
+		return false;
+	}
+
+	// The displayed region, not the whole surface: get_present_source accepts surfaces larger
+	// than the display buffer (fit-or-crop, stereo stacks both eyes), and buffer_width x
+	// buffer_height is what the present blit and the screenshot path take from it.
+	const u32 src_w = std::min(src->width(), region_w ? region_w : src->width());
+	const u32 src_h = std::min(src->height(), region_h ? region_h : src->height());
+	if (!src_w || !src_h)
+	{
+		return false;
+	}
+	const bool native = ticket.full || !ticket.width || !ticket.height;
+	const u32 dst_w = native ? src_w : std::clamp<u32>(ticket.width, 1, src_w);
+	const u32 dst_h = native ? src_h : std::clamp<u32>(ticket.height, 1, src_h);
+	const usz size = usz{dst_w} * dst_h * 4;
+
+	if (!m_pitlink_tap_img || m_pitlink_tap_img->width() != dst_w || m_pitlink_tap_img->height() != dst_h)
+	{
+		if (m_pitlink_tap_img)
+		{
+			vk::get_resource_manager()->dispose(m_pitlink_tap_img);
+		}
+
+		m_pitlink_tap_img = std::make_unique<vk::image>(*m_device, m_device->get_memory_mapping().device_local, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+			VK_IMAGE_TYPE_2D, VK_FORMAT_B8G8R8A8_UNORM, dst_w, dst_h, 1, 1, 1, VK_SAMPLE_COUNT_1_BIT,
+			VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+			0, VMM_ALLOCATION_POOL_SYSTEM);
+	}
+
+	if (!slot->buf || slot->buf->size() < size)
+	{
+		// Through the deferred collector, not in place: a slot freed by a failed swap wait may
+		// still have its copy in flight.
+		if (slot->buf)
+		{
+			vk::get_resource_manager()->dispose(slot->buf);
+		}
+		slot->buf = std::make_unique<vk::buffer>(*m_device, utils::align(size, 0x100000), m_device->get_memory_mapping().host_visible_coherent,
+			VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, VK_BUFFER_USAGE_TRANSFER_DST_BIT, 0, VMM_ALLOCATION_POOL_UNDEFINED);
+	}
+
+	const vk::command_buffer& cmd = *m_current_command_buffer;
+
+	src->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+	m_pitlink_tap_img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+
+	VkImageBlit blit{};
+	blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	blit.srcOffsets[1] = { static_cast<s32>(src_w), static_cast<s32>(src_h), 1 };
+	blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	blit.dstOffsets[1] = { static_cast<s32>(dst_w), static_cast<s32>(dst_h), 1 };
+	vkCmdBlitImage(cmd, src->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, m_pitlink_tap_img->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+		1, &blit, (dst_w == src_w && dst_h == src_h) ? VK_FILTER_NEAREST : VK_FILTER_LINEAR);
+
+	src->pop_layout(cmd);
+	m_pitlink_tap_img->change_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+
+	VkBufferImageCopy copy_info{};
+	copy_info.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	copy_info.imageExtent = { dst_w, dst_h, 1 };
