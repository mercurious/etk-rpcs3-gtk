+
+	slot->ctx = m_current_frame;
+	slot->ticket = std::move(ticket);
+	slot->width = dst_w;
+	slot->height = dst_h;
+	slot->busy = true;
+	return true;
+}
+
+// Only after a hard sync, when every recorded tap has retired. Normally a no-op -- the sync's own
+// frame_context_cleanup pass already harvested them -- kept so no slot can survive into the
+// synchronous tap that follows (oldest first, so that tap is the newest frame the server holds).
+void VKGSRender::pitlink_harvest_all()
+{
+	std::array<pitlink_tap_slot*, 3> order{};
+	usz n = 0;
+	for (auto& slot : m_pitlink_slots)
+	{
+		if (slot.busy)
+		{
+			order[n++] = &slot;
+		}
+	}
+
+	std::sort(order.begin(), order.begin() + n, [](const pitlink_tap_slot* a, const pitlink_tap_slot* b)
+	{
+		return a->ticket.flip < b->ticket.flip;
+	});
+
+	for (usz i = 0; i < n; i++)
+	{
+		if (order[i]->busy)
+		{
+			pitlink_harvest(order[i]->ctx, true);
+		}
+	}
+}
+
+void VKGSRender::pitlink_harvest(vk::frame_context_t* ctx, bool retired)
+{
+	for (auto& slot : m_pitlink_slots)
+	{
+		if (!slot.busy || slot.ctx != ctx)
+		{
+			continue;
+		}
+
+		if (retired && slot.buf)
+		{
+			const usz size = usz{slot.width} * slot.height * 4;
+			const auto* pixels = static_cast<const u8*>(slot.buf->map(0, size));
+			pitlink::submit_frame(std::move(slot.ticket), pixels, slot.width, slot.height, true);
+			slot.buf->unmap();
+		}
+
+		slot.ticket = {};
+		slot.busy = false;
+		slot.ctx = nullptr;
+	}
+}
+
+// Children of the device: released by the destructor right after vkDeviceWaitIdle, never left
+// to implicit member destruction (0.9.1.2 was an exit abort of exactly that ordering class).
+void VKGSRender::pitlink_release()
+{
+	for (auto& slot : m_pitlink_slots)
+	{
+		slot.buf.reset();
+		slot.ticket = {};
+		slot.busy = false;
+		slot.ctx = nullptr;
+	}
+
+	m_pitlink_tap_img.reset();
+}
