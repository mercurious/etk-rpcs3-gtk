+		constexpr usz k_max_msg = 16u << 20;
+		constexpr usz k_max_sched = 64;     // scheduled PADs per port
+
+		enum msg : u16
+		{
+			HELLO = 0x0001, PING = 0x0002,
+			PAD = 0x0010, PAD_RELEASE = 0x0011,
+			VIDEO = 0x0020, SNAP = 0x0021,
+			RAM_READ = 0x0030, RAM_WRITE = 0x0031, WATCH = 0x0032,
+			PAUSE = 0x0040, RESUME = 0x0041, STEP = 0x0042, EXIT = 0x0043,
+			STATUS = 0x0050,
+			HELLO_OK = 0x8001, PONG = 0x8002, ACK = 0x800F, RAM_DATA = 0x8030,
+			STATUS_REPLY = 0x8050, FRAME = 0x8090, EVENT = 0x80A0,
+		};
+
+		enum event_kind : u16
+		{
+			EV_BOOT = 1, EV_STATE = 2, EV_TITLE = 3, EV_DEADMAN = 4, EV_RESCUE = 5, EV_ERROR = 6, EV_STEP = 7,
+		};
+
+		struct config
+		{
+			bool enabled = false;
+			std::string tcp;   // "a.b.c.d:port" or "iface:port"
+			std::string token;
+			u32 video_w = 640, video_h = 360, video_hz = 30;
+			u8 pad_mode = 1;   // 0 off, 1 merge, 2 exclusive
+			u32 ttl_ms = 500;
+		};
+
+		std::string env_str(const char* name)
+		{
+			const char* v = std::getenv(name);
+			return v ? std::string(v) : std::string();
+		}
+
+		// Heap, never destroyed: the detached server thread may still read it while static
+		// destructors run at process exit.
+		const config& conf()
+		{
+			static const config* const c = []()
+			{
+				config* r = new config();
+				r->enabled = env_str("GTK_PITLINK") == "1";
+				r->tcp = env_str("GTK_PITLINK_TCP");
+				r->token = env_str("GTK_PITLINK_TOKEN");
+
+				// "640x360@30"; "0" = no stream (SNAP still works)
+				const std::string video = env_str("GTK_PITLINK_VIDEO");
+				if (video == "0")
+				{
+					r->video_w = r->video_h = r->video_hz = 0;
+				}
+				else if (!video.empty())
+				{
+					unsigned w = 0, h = 0, hz = 0;
+					if (std::sscanf(video.c_str(), "%ux%u@%u", &w, &h, &hz) == 3 && w && h && hz)
+					{
+						r->video_w = w;
+						r->video_h = h;
+						r->video_hz = hz;
+					}
+				}
+
+				const std::string pad = env_str("GTK_PITLINK_PAD");
+				if (pad == "off") r->pad_mode = 0;
+				else if (pad == "exclusive") r->pad_mode = 2;
+
+				if (const std::string ttl = env_str("GTK_PITLINK_TTL_MS"); !ttl.empty())
+				{
+					const long v = std::strtol(ttl.c_str(), nullptr, 10);
+					if (v >= 50 && v <= 60000) r->ttl_ms = static_cast<u32>(v);
+				}
+				return r;
+			}();
+			return *c;
+		}
+
+		u64 now_ns()
+		{
+#ifdef PITLINK_SUPPORTED
+			timespec ts{};
+			clock_gettime(CLOCK_MONOTONIC, &ts);
+			return static_cast<u64>(ts.tv_sec) * 1'000'000'000ull + static_cast<u64>(ts.tv_nsec);
+#else
+			return 0;
+#endif
+		}
+
+		// One agent pad state. Live on a port (pad_now) or scheduled for a flip (pad_sched).
+		struct pad_cmd
+		{
+			bool active = false;
+			u8 mode = 1;
+			u16 buttons = 0;
+			std::array<u8, 12> pressure{};
+			u8 lx = 128, ly = 128, rx = 128, ry = 128;
+			u64 at_flip = 0;
+		};
+
+		bool is_neutral(const pad_cmd& c)
+		{
+			return !c.buttons && c.lx == 128 && c.ly == 128 && c.rx == 128 && c.ry == 128;
+		}
+
+		struct out_frame
+		{
+			frame_ticket meta;
+			std::vector<u8> bgra;
+			u32 width = 0;
+			u32 height = 0;
+		};
+
+		struct state
+		{
+			std::once_flag started;
+
+			// CLOCK (RSX thread writes)
+			std::atomic<u64> flip{0};
+			std::atomic<u64> last_flip_ns{0};
+			std::atomic<u64> vblank{0};      // cached at the flip: the server never touches rsx::thread
+			std::atomic<f32> fps{0.f};
+			std::atomic<u32> step_left{0};
+
+			// EYES config (server writes, RSX reads)
+			std::atomic<u32> clients{0};     // HELLO'd connections
+			std::mutex video_mtx;
+			u32 vw = 0, vh = 0, vhz = 0;
+			u8 codec = 1, zlevel = 1;
+			bool snap_pending = false;
+			u8 snap_codec = 1;
+			u64 last_tap_ns = 0;
+
+			// MEMORY watch list
+			std::mutex watch_mtx;
+			std::vector<std::pair<u32, u8>> watch;
+			usz watch_bytes = 0;
+
+			// HANDS
+			std::mutex pad_mtx;
+			std::array<pad_cmd, k_ports> pad_now{};
+			// PADs stamped for a future flip, ordered by at_flip (a press is two of them:
+			// down at F, up at F+n -- a single slot would let the release overwrite the press).
+			std::array<std::vector<pad_cmd>, k_ports> pad_sched{};
+			// Dead-man per port: refreshed by EVERY PAD received (now or scheduled), so a dead
+			// link releases the live state AND drops whatever was scheduled.
+			std::array<u64, k_ports> pad_deadline{};
+
+			// server outbox: the latest stream frame (latest-wins), frames that are OWED (a SNAP, the
+			// frame a STEP stopped on -- never overwritten by a stream frame), queued events
+			std::mutex out_mtx;
+			std::optional<out_frame> frame;
+			std::deque<out_frame> owed;
+			std::deque<std::pair<u16, std::string>> events;
+			int wake_fd = -1;
+		};
+
+		// Never destroyed: the server thread outlives static destruction at process exit.
+		state& st()
+		{
+			static state* const s = new state();
+			return *s;
+		}
+
+		void wake()
+		{
+#ifdef PITLINK_SUPPORTED
+			const int fd = st().wake_fd;
+			if (fd >= 0)
+			{
+				const u64 one = 1;
+				[[maybe_unused]] const auto r = ::write(fd, &one, sizeof(one));
+			}
+#endif
+		}
+
+		void queue_event(u16 kind, std::string text)
+		{
+			auto& s = st();
+			{
+				std::lock_guard lock(s.out_mtx);
+				if (s.events.size() < 256)
+				{
+					s.events.emplace_back(kind, std::move(text));
+				}
+			}
+			wake();
+		}
+
+		// PAD button bit (PLNK v1) for a cellPad (offset, keycode); -1 = not ours (PS, specials).
+		int button_bit(u32 offset, u32 keycode)
+		{
+			if (offset == CELL_PAD_BTN_OFFSET_DIGITAL1)
+			{
+				for (int i = 0; i < 8; i++)
+				{
+					if (keycode == (1u << i)) return i;
+				}
+			}
+			else if (offset == CELL_PAD_BTN_OFFSET_DIGITAL2)
+			{
+				for (int i = 0; i < 8; i++)
+				{
+					if (keycode == (1u << i)) return 8 + i;
+				}
+			}
+			return -1;
+		}
+
+		// Index into PAD.pressure[] (= cellPad press offset - 8) for a button bit; -1 = none.
+		int pressure_index(int bit)
+		{
+			switch (bit)
+			{
+			case 4: return CELL_PAD_BTN_OFFSET_PRESS_UP - 8;
+			case 5: return CELL_PAD_BTN_OFFSET_PRESS_RIGHT - 8;
+			case 6: return CELL_PAD_BTN_OFFSET_PRESS_DOWN - 8;
+			case 7: return CELL_PAD_BTN_OFFSET_PRESS_LEFT - 8;
+			case 8: return CELL_PAD_BTN_OFFSET_PRESS_L2 - 8;
+			case 9: return CELL_PAD_BTN_OFFSET_PRESS_R2 - 8;
+			case 10: return CELL_PAD_BTN_OFFSET_PRESS_L1 - 8;
+			case 11: return CELL_PAD_BTN_OFFSET_PRESS_R1 - 8;
+			case 12: return CELL_PAD_BTN_OFFSET_PRESS_TRIANGLE - 8;
+			case 13: return CELL_PAD_BTN_OFFSET_PRESS_CIRCLE - 8;
+			case 14: return CELL_PAD_BTN_OFFSET_PRESS_CROSS - 8;
+			case 15: return CELL_PAD_BTN_OFFSET_PRESS_SQUARE - 8;
+			default: return -1;
+			}
+		}
+
+		// RAM_READ / RAM_WRITE (server thread) and WATCH (RSX thread, at the flip): vm::try_access holds a range lock, so a
+		// concurrent unmap cannot pull the page out from under the copy. Writes go to the sudo
+		// mirror too -- they do not invalidate texture-cache copies, which is fine for the game
+		// state Pitlink pokes (see spec 2.4).
+		bool guest_read(u32 addr, u32 size, u8* dst)
+		{
+			return size && vm::try_access(addr, dst, size, false);
+		}
+
+		bool guest_write(u32 addr, u32 size, const u8* src)
+		{
+			// try_access only reads from ptr when is_write is set
+			return size && vm::try_access(addr, const_cast<u8*>(src), size, true);
+		}
+
+		// Clock changes run on the main thread, in arrival order with each other (a STEP's resume
+		// can never land after a later PAUSE), and the server waits -- bounded -- for them to have
+		// happened, so the ACK means "applied", not "queued". Not BlockingCallFromMainThread: that
+		// expects a named_thread caller and waits forever if the call is dropped.
+		bool on_main_thread(std::function<void()> fn, u32 timeout_ms = 2000)
+		{
+			auto done = std::make_shared<std::atomic<bool>>(false);
+			Emu.CallFromMainThread([fn = std::move(fn), done]()
+			{
+				fn();
+				done->store(true);
+			});
+			for (u32 i = 0; i < timeout_ms && !done->load(); i++)
+			{
+				std::this_thread::sleep_for(std::chrono::milliseconds(1));
+			}
+			return done->load();
+		}
+
+		u32 emu_state_code()
+		{
+			switch (Emu.GetStatus())
+			{
+			case system_state::running: return 0;
+			case system_state::paused: return 1;
+			default: return 2;
+			}
+		}
+
+#ifdef PITLINK_SUPPORTED
+		// ---------------------------------------------------------------- wire helpers
+		void put_u8(std::string& b, u8 v) { b.push_back(static_cast<char>(v)); }
+		void put_u16(std::string& b, u16 v) { put_u8(b, v & 0xff); put_u8(b, v >> 8); }
+		void put_u32(std::string& b, u32 v) { put_u16(b, v & 0xffff); put_u16(b, v >> 16); }
+		void put_u64(std::string& b, u64 v) { put_u32(b, v & 0xffffffffu); put_u32(b, static_cast<u32>(v >> 32)); }
+		void put_f32(std::string& b, f32 v) { u32 u; std::memcpy(&u, &v, 4); put_u32(b, u); }
+		void put_str(std::string& b, const std::string& s)
+		{
+			const usz n = std::min<usz>(s.size(), 0xffff);
+			put_u16(b, static_cast<u16>(n));
+			b.append(s.data(), n);
+		}
+
+		struct reader
+		{
+			const u8* p;
+			usz n;
+			usz off = 0;
+			bool ok = true;
+
+			bool need(usz k) { if (off + k > n) ok = false; return ok; }
+			u8 u8_() { if (!need(1)) return 0; return p[off++]; }
+			u16 u16_() { if (!need(2)) return 0; const u16 v = static_cast<u16>(p[off] | (p[off + 1] << 8)); off += 2; return v; }
+			u32 u32_() { const u32 lo = u16_(); const u32 hi = u16_(); return lo | (hi << 16); }
+			u64 u64_() { const u64 lo = u32_(); const u64 hi = u32_(); return lo | (hi << 32); }
+			std::string str() { const u16 k = u16_(); if (!need(k)) return {}; std::string s(reinterpret_cast<const char*>(p + off), k); off += k; return s; }
+			const u8* bytes(usz k) { if (!need(k)) return nullptr; const u8* r = p + off; off += k; return r; }
+		};
+
+		std::string make_msg(u16 type, u32 seq, const std::string& payload)
+		{
+			std::string m;
+			m.reserve(16 + payload.size());
+			put_u32(m, k_magic);
+			put_u16(m, type);
+			put_u16(m, 0);
+			put_u32(m, seq);
+			put_u32(m, static_cast<u32>(payload.size()));
+			m += payload;
+			return m;
+		}
+
+		std::string ack(u16 for_type, s16 status, const std::string& text = {})
+		{
+			std::string p;
+			put_u16(p, for_type);
+			put_u16(p, static_cast<u16>(status));
+			put_str(p, text);
+			return p;
+		}
+
+		// ---------------------------------------------------------------- server
+		struct client
+		{
+			int fd = -1;             // -2: close after flushing what is queued; -3: closed
+			u64 since_ns = 0;        // accept time (a socket that never HELLOs is reaped)
+			bool hello = false;
+			bool controller = false;
+			bool send_last = false;  // owed the most recent frame (a paused car sends no new ones)
+			std::string in;
+			std::string out;
+			usz out_off = 0;
+			usz frame_end = 0;       // out offset where the last queued frame ends (latest-wins gate)
+		};
+
+		void set_nonblock(int fd)
+		{
+			const int fl = ::fcntl(fd, F_GETFL, 0);
+			::fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+		}
+
+		int listen_abstract()
+		{
+			const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+			if (fd < 0) return -1;
+
+			sockaddr_un sa{};
+			sa.sun_family = AF_UNIX;
+			static constexpr char name[] = "etk-pitlink";
+			sa.sun_path[0] = '\0';
+			std::memcpy(sa.sun_path + 1, name, sizeof(name) - 1);
+			const socklen_t len = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 + sizeof(name) - 1);
+
+			if (::bind(fd, reinterpret_cast<sockaddr*>(&sa), len) != 0 || ::listen(fd, 8) != 0)
+			{
+				pitlink_log.error("abstract socket @etk-pitlink: %s", std::string(std::strerror(errno)));
+				::close(fd);
+				return -1;
+			}
+			set_nonblock(fd);
+			return fd;
+		}
+
+		// "a.b.c.d:port" or "iface:port" (the USB-net gadget, whose address differs per car).
+		// Never ANY: a link that steers the car is not offered to every network the rig is on.
+		int listen_tcp(const std::string& spec, bool quiet)
+		{
+			const usz colon = spec.rfind(':');
+			if (colon == std::string::npos) return -1;
+			const std::string host = spec.substr(0, colon);
+			const int port = std::atoi(spec.c_str() + colon + 1);
+			if (port <= 0 || port > 65535) return -1;
+
+			in_addr addr{};
+			if (::inet_pton(AF_INET, host.c_str(), &addr) != 1)
+			{
+				ifaddrs* ifs = nullptr;
+				bool found = false;
+				if (::getifaddrs(&ifs) == 0)
+				{
+					for (ifaddrs* i = ifs; i; i = i->ifa_next)
+					{
+						if (i->ifa_addr && i->ifa_addr->sa_family == AF_INET && i->ifa_name && host == i->ifa_name)
+						{
+							addr = reinterpret_cast<sockaddr_in*>(i->ifa_addr)->sin_addr;
+							found = true;
+							break;
+						}
+					}
+					::freeifaddrs(ifs);
+				}
+				if (!found)
+				{
+					if (!quiet) pitlink_log.warning("TCP: interface '%s' has no IPv4 address yet; will retry", host);
+					return -1;
+				}
+			}
+
+			if (addr.s_addr == htonl(INADDR_ANY))
+			{
+				if (!quiet) pitlink_log.error("TCP: refusing to listen on every interface (%s); name one address or interface", spec);
+				return -1;
+			}
+
+			const int fd = ::socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+			if (fd < 0) return -1;
+			const int one = 1;
+			::setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+
+			sockaddr_in sa{};
+			sa.sin_family = AF_INET;
+			sa.sin_port = htons(static_cast<u16>(port));
+			sa.sin_addr = addr;
+			if (::bind(fd, reinterpret_cast<sockaddr*>(&sa), sizeof(sa)) != 0 || ::listen(fd, 8) != 0)
+			{
+				if (!quiet) pitlink_log.warning("TCP %s: %s; will retry", spec, std::string(std::strerror(errno)));
+				::close(fd);
+				return -1;
+			}
+			set_nonblock(fd);
+			char txt[INET_ADDRSTRLEN]{};
+			::inet_ntop(AF_INET, &addr, txt, sizeof(txt));
+			pitlink_log.success("listening on %s:%d", std::string(txt), port);
+			return fd;
+		}
+
+		std::string encode_frame(out_frame& f, u8 codec, u8 level)
+		{
+			const usz raw = f.bgra.size();
+			std::string img;
+			if (codec == 1)
+			{
+				img.resize(ZSTD_compressBound(raw));
+				const usz n = ZSTD_compress(img.data(), img.size(), f.bgra.data(), raw, level ? level : 1);
+				if (ZSTD_isError(n))
+				{
+					codec = 0;
+				}
+				else
+				{
+					img.resize(n);
+				}
+			}
+			if (codec != 1)
+			{
+				codec = 0;
+				img.assign(reinterpret_cast<const char*>(f.bgra.data()), raw);
+			}
+
+			std::string p;
+			p.reserve(36 + f.meta.watch.size() + img.size());
+			put_u64(p, f.meta.flip);
+			put_u64(p, f.meta.vblank);
+			put_u64(p, f.meta.host_ns);
+			put_u16(p, static_cast<u16>(f.width));
+			put_u16(p, static_cast<u16>(f.height));
+			put_u8(p, codec);
+			put_u8(p, f.meta.full ? 1 : 0);
+			put_u16(p, static_cast<u16>(f.meta.watch.size()));
+			put_f32(p, f.meta.fps);
+			p.append(reinterpret_cast<const char*>(f.meta.watch.data()), f.meta.watch.size());
+			p += img;
+			return make_msg(FRAME, 0, p);
+		}
+
+		void on_message(client& c, std::vector<client>& all, u16 type, u32 seq, const u8* data, usz len)
+		{
+			auto& s = st();
+			reader r{data, len};
+			const auto reply = [&](u16 t, const std::string& payload) { c.out += make_msg(t, seq, payload); };
+
+			if (!c.hello && type != HELLO)
+			{
+				if (!conf().token.empty())
+				{
+					c.fd = -2; // a token is set: HELLO must come first -- close, no reply
+					return;
+				}
+				if (type != PING && type != STATUS && type != RAM_READ)
+				{
+					reply(ACK, ack(type, -2, "HELLO first"));
+					return;
+				}
+			}
+
+			const bool control = type == PAD || type == PAD_RELEASE || type == VIDEO || type == SNAP ||
+				type == RAM_WRITE || type == WATCH || type == PAUSE || type == RESUME || type == STEP || type == EXIT;
+			if (control && !c.controller)
+			{
+				reply(ACK, ack(type, -1, "observer"));
+				return;
+			}
+
+			switch (type)
+			{
+			case HELLO:
+			{
+				const u16 proto = r.u16_();
+				r.u16_();
+				const std::string token = r.str();
+				if (!conf().token.empty() && token != conf().token)
+				{
+					c.fd = -2; // bad token: close, no reply
+					return;
+				}
+				if (!r.ok || proto != k_proto)
+				{
+					reply(ACK, ack(HELLO, -1, "unsupported protocol"));
+					return;
+				}
+				if (!c.hello)
+				{
+					c.hello = true;
+					c.send_last = true;
+					if (s.clients++ == 0)
+					{
+						// First viewer: arm EYES with the environment's default size and rate.
+						std::lock_guard lock(s.video_mtx);
+						s.vw = conf().video_w;
+						s.vh = conf().video_h;
+						s.vhz = conf().video_hz;
+						s.last_tap_ns = 0;
+					}
+				}
+
+				// The role is decided at every HELLO: the wheel goes to whoever asks while it is
+				// free. No silent promotion -- a reconnecting driver must never find a passive
+				// dashboard holding the wheel it was quietly handed.
+				bool taken = false;
+				for (const auto& o : all)
+				{
+					taken |= (&o != &c && o.fd >= 0 && o.hello && o.controller);
+				}
+				c.controller = !taken;
+
+				std::string p;
+				put_u16(p, k_proto);
+				put_u16(p, 0xF); // video | pad | ram | clock
+				put_u32(p, c.controller ? 0 : 1);
+				put_str(p, rpcs3::get_verbose_version());
+				put_str(p, Emu.GetTitleID());
+				put_str(p, Emu.GetTitle());
+				reply(HELLO_OK, p);
+				pitlink_log.notice("client %d: HELLO role=%s", c.fd, c.controller ? "controller" : "observer");
+				return;
+			}
+			case PING:
+			{
+				std::string p;
+				put_u64(p, s.flip.load());
+				put_u64(p, now_ns());
+				reply(PONG, p);
+				return;
+			}
+			case PAD:
+			{
+				pad_cmd cmd;
+				const u8 port = r.u8_();
+				const u8 mode = r.u8_();
+				cmd.buttons = r.u16_();
+				if (const u8* pr = r.bytes(12)) std::memcpy(cmd.pressure.data(), pr, 12);
+				cmd.lx = r.u8_();
+				cmd.ly = r.u8_();
+				cmd.rx = r.u8_();
+				cmd.ry = r.u8_();
+				const u16 ttl = r.u16_();
+				r.u16_();
+				const u64 at_flip = r.u64_();
+				if (!r.ok || port >= k_ports || (mode > 2 && mode != 255))
+				{
+					reply(ACK, ack(PAD, -4, "bad PAD"));
+					return;
+				}
+				cmd.active = true;
+				cmd.mode = mode == 255 ? conf().pad_mode : mode;
+				const u32 ttl_ms = ttl ? ttl : conf().ttl_ms;
+
+				std::lock_guard lock(s.pad_mtx);
+				if (at_flip && at_flip > s.flip.load())
+				{
+					auto& q = s.pad_sched[port];
+					if (q.size() >= k_max_sched)
+					{
+						reply(ACK, ack(PAD, -7, "schedule full"));
+						return;
+					}
+					cmd.at_flip = at_flip;
+					// Ordered by at_flip; equal stamps keep arrival order (upper_bound).
+					const auto pos = std::upper_bound(q.begin(), q.end(), at_flip,
+						[](u64 f, const pad_cmd& e) { return f < e.at_flip; });
+					q.insert(pos, cmd);
+				}
+				else
+				{
+					// "Now" replaces the live state; it never cancels what is scheduled.
+					s.pad_now[port] = cmd;
+				}
+				s.pad_deadline[port] = now_ns() + u64{ttl_ms} * 1'000'000ull;
+				return;
+			}
+			case PAD_RELEASE:
+			{
+				const u8 port = r.u8_();
+				if (port < k_ports)
+				{
+					std::lock_guard lock(s.pad_mtx);
+					s.pad_now[port] = pad_cmd{};
+					s.pad_sched[port].clear();
+					s.pad_deadline[port] = 0;
+				}
+				return;
+			}
+			case VIDEO:
+			{
+				const u16 w = r.u16_(), h = r.u16_(), hz = r.u16_();
+				const u8 codec = r.u8_(), level = r.u8_();
+				r.u8_(); // overlays: v1 taps the game image only (pre-overlay)
+				if (!r.ok || codec > 1)
+				{
+					reply(ACK, ack(VIDEO, -4, "bad VIDEO"));
+					return;
+				}
+				{
+					std::lock_guard lock(s.video_mtx);
+					s.vw = w; // 0 = native
+					s.vh = h;
+					s.vhz = std::min<u16>(hz, 120);
+					s.codec = codec;
+					s.zlevel = level ? std::min<u8>(level, 19) : 1;
+					s.last_tap_ns = 0;
+				}
+				reply(ACK, ack(VIDEO, 0));
+				return;
+			}
+			case SNAP:
+			{
+				const u8 codec = r.u8_();
+				if (!r.ok || codec > 1)
+				{
+					reply(ACK, ack(SNAP, -4, "bad SNAP"));
+					return;
+				}
+				{
+					std::lock_guard lock(s.video_mtx);
+					s.snap_pending = true;
+					s.snap_codec = codec;
+				}
+				if (emu_state_code() == 1)
+				{
+					// Paused: no game flip is coming, so ask the RSX thread for a native-UI flip
+					// to serve the SNAP on (read back synchronously, see want_frame).
+					rsx::set_native_ui_flip();
+				}
+				reply(ACK, ack(SNAP, 0));
+				return;
+			}
+			case RAM_READ:
+			{
+				const u32 n = r.u32_();
+				if (!r.ok || n > 4096)
+				{
+					reply(ACK, ack(RAM_READ, -1, "bad RAM_READ"));
+					return;
+				}
+				std::string p;
+				put_u32(p, n);
+				std::vector<u8> tmp;
+				for (u32 i = 0; i < n; i++)
+				{
+					const u32 addr = r.u32_();
+					const u32 size = r.u32_();
+					if (!r.ok || p.size() > (8u << 20))
+					{
+						reply(ACK, ack(RAM_READ, -4, "bad RAM_READ item"));
+						return;
+					}
+					const bool fits = size <= 65536;
+					tmp.resize(fits ? size : 0);
+					const bool ok = fits && guest_read(addr, size, tmp.data());
+					put_u8(p, ok ? 1 : 0);
+					put_u32(p, ok ? size : 0);
+					if (ok) p.append(reinterpret_cast<const char*>(tmp.data()), size);
+				}
+				reply(RAM_DATA, p);
+				return;
+			}
+			case RAM_WRITE:
+			{
+				const u32 addr = r.u32_();
+				const u32 size = r.u32_();
+				const u8* bytes = r.bytes(size);
+				const bool ok = r.ok && bytes && size <= 65536 && guest_write(addr, size, bytes);
+				reply(ACK, ack(RAM_WRITE, ok ? 0 : -5, ok ? "" : "unwritable"));
+				return;
+			}
+			case WATCH:
+			{
+				const u32 n = r.u32_();
+				if (!r.ok || n > 256)
+				{
+					reply(ACK, ack(WATCH, -1, "bad WATCH"));
+					return;
+				}
+				std::vector<std::pair<u32, u8>> list;
+				usz total = 0;
+				for (u32 i = 0; i < n; i++)
+				{
+					const u32 addr = r.u32_();
+					const u8 size = r.u8_();
+					r.bytes(3);
+					if (size != 1 && size != 2 && size != 4 && size != 8)
+					{
+						r.ok = false;
+					}
+					list.emplace_back(addr, size);
+					total += size;
+				}
+				if (!r.ok)
+				{
+					reply(ACK, ack(WATCH, -1, "bad WATCH item"));
+					return;
+				}
+				{
+					std::lock_guard lock(s.watch_mtx);
+					s.watch = std::move(list);
+					s.watch_bytes = total;
+				}
+				reply(ACK, ack(WATCH, 0));
+				return;
+			}
+			case PAUSE:
+			{
+				const bool ok = on_main_thread([]()
+				{
+					auto& ss = st();
+					ss.step_left = 0;
+					ss.last_flip_ns = 0; // the fps EMA must not average across the pause
+					Emu.Pause(false, false);
+				});
+				reply(ACK, ack(PAUSE, ok ? 0 : -8, ok ? "" : "main thread busy"));
+				return;
+			}
+			case RESUME:
+			{
+				const bool ok = on_main_thread([]()
+				{
+					st().step_left = 0;
+					Emu.Resume();
+				});
+				reply(ACK, ack(RESUME, ok ? 0 : -8, ok ? "" : "main thread busy"));
+				return;
+			}
+			case STEP:
+			{
+				const u32 flips = r.u32_();
+				if (!r.ok || !flips)
+				{
+					reply(ACK, ack(STEP, -1, "bad STEP"));
+					return;
+				}
+				const bool ok = on_main_thread([flips]()
+				{
+					st().step_left = flips;
+					if (Emu.IsPaused())
+					{
+						Emu.Resume();
+					}
+				});
+				reply(ACK, ack(STEP, ok ? 0 : -8, ok ? "" : "main thread busy"));
+				return;
+			}
+			case EXIT:
+			{
+				const bool savestate = r.u8_() != 0;
+				Emu.CallFromMainThread([savestate]() { Emu.GracefulShutdown(true, false, savestate); });
+				reply(ACK, ack(EXIT, 0));
+				return;
+			}
+			case STATUS:
+			{
+				std::string p;
+				put_u32(p, emu_state_code());
+				put_u64(p, s.flip.load());
+				put_u64(p, s.vblank.load());
+				put_str(p, Emu.GetTitleID());
+				put_str(p, Emu.GetTitle());
+				reply(STATUS_REPLY, p);
+				return;
+			}
+			default:
+				reply(ACK, ack(type, -1, "unknown type"));
+				return;
+			}
+		}
+
+		[[noreturn]] void server_main()
+		{
+			auto& s = st();
+			const int lfd_unix = listen_abstract();
+			int lfd_tcp = -1;
+			u64 tcp_retry_ns = 0;
+			bool tcp_warned = false;
+
+			if (lfd_unix >= 0)
+			{
+				pitlink_log.success("listening on @etk-pitlink");
+			}
+
+			std::vector<client> clients;
+			std::string last_frame_msg;
+			u32 last_state = ~0u;
+			std::string last_title;
+			u64 title_poll_ns = 0;
+
+			while (true)
+			{
+				const u64 now = now_ns();
+
+				// TCP: the gadget may come up after RPCS3 (USB plugged in mid-session) -- retry.
+				if (lfd_tcp < 0 && !conf().tcp.empty() && now >= tcp_retry_ns)
+				{
+					lfd_tcp = listen_tcp(conf().tcp, tcp_warned);
+					tcp_warned = true;
+					tcp_retry_ns = now + 5'000'000'000ull;
+				}
+
+				// Emulator state / title changes become pushed EVENTs.
+				if (!clients.empty())
+				{
+					const u32 code = emu_state_code();
+					if (code != last_state)
+					{
+						last_state = code;
+						queue_event(EV_STATE, code == 0 ? "running" : code == 1 ? "paused" : "stopped");
+					}
+					if (now >= title_poll_ns)
+					{
+						title_poll_ns = now + 1'000'000'000ull;
+						if (std::string title = Emu.GetTitleID(); title != last_title)
+						{
+							last_title = std::move(title);
+							last_frame_msg.clear(); // a new boot owes nobody the old game's picture
+							queue_event(EV_TITLE, last_title);
+						}
+					}
+				}
+
+				// A SNAP is pending while paused (e.g. PAUSE then SNAP in quick succession): no game
+				// flip will come, and a silent pause runs no native-UI refresh -- ask for one.
+				if (!clients.empty() && emu_state_code() == 1)
+				{
+					bool snap;
+					{
+						std::lock_guard lock(s.video_mtx);
+						snap = s.snap_pending;
+					}
+					if (snap)
+					{
+						rsx::set_native_ui_flip();
+					}
+				}
+
+				std::vector<pollfd> pfds;
+				pfds.push_back({s.wake_fd, POLLIN, 0});
+				if (lfd_unix >= 0) pfds.push_back({lfd_unix, POLLIN, 0});
+				if (lfd_tcp >= 0) pfds.push_back({lfd_tcp, POLLIN, 0});
+				const usz first_client = pfds.size();
+				for (const auto& c : clients)
+				{
+					pfds.push_back({c.fd, static_cast<short>(POLLIN | (c.out_off < c.out.size() ? POLLOUT : 0)), 0});
+				}
+
+				if (::poll(pfds.data(), pfds.size(), 100) < 0 && errno != EINTR)
+				{
+					pitlink_log.error("poll: %s", std::string(std::strerror(errno)));
+					std::this_thread::sleep_for(std::chrono::milliseconds(100));
+					continue;
+				}
+
+				// Outbox: the newest frame (encoded once) and any events, to every HELLO'd client.
+				if (pfds[0].revents & POLLIN)
+				{
+					u64 drain = 0;
+					[[maybe_unused]] const auto rr = ::read(s.wake_fd, &drain, sizeof(drain));
+				}
+				{
+					std::optional<out_frame> frame;
+					std::deque<out_frame> owed;
+					std::deque<std::pair<u16, std::string>> events;
+					{
+						std::lock_guard lock(s.out_mtx);
+						frame.swap(s.frame);
+						owed.swap(s.owed);
+						events.swap(s.events);
+					}
+
+					// Oldest first. A SNAP or the frame a STEP stopped on is owed to everyone; a
+					// stream frame is latest-wins per client (a viewer still draining the previous
+					// one skips it rather than queueing a backlog).
+					if (frame)
+					{
+						owed.push_back(std::move(*frame)); // a stream frame: full/sync stay false
+					}
+					std::stable_sort(owed.begin(), owed.end(), [](const out_frame& a, const out_frame& b) { return a.meta.flip < b.meta.flip; });
+
+					for (auto& f : owed)
+					{
+						u8 codec, level;
+						{
+							std::lock_guard lock(s.video_mtx);
+							codec = f.meta.full ? s.snap_codec : s.codec;
+							level = s.zlevel;
+						}
+						const bool must = f.meta.full || f.meta.sync;
+						const std::string msg = encode_frame(f, codec, level);
+						last_frame_msg = msg;
+						for (auto& c : clients)
+						{
+							if (c.hello && (must || c.out_off >= c.frame_end))
+							{
+								c.out += msg;
+								c.frame_end = c.out.size();
+							}
+						}
+					}
+
+					for (const auto& [kind, text] : events)
+					{
+						std::string p;
+						put_u16(p, kind);
+						put_str(p, text);
+						const std::string msg = make_msg(EVENT, 0, p);
+						for (auto& c : clients)
+						{
+							if (c.hello) c.out += msg;
+						}
+					}
+				}
+
+				// Accept
+				for (usz i = 1; i < first_client; i++)
+				{
+					if (!(pfds[i].revents & POLLIN)) continue;
+					const int fd = ::accept4(pfds[i].fd, nullptr, nullptr, SOCK_CLOEXEC | SOCK_NONBLOCK);
+					if (fd < 0) continue;
+					if (clients.size() >= 4)
+					{
+						::close(fd);
+						continue;
+					}
+					if (pfds[i].fd == lfd_tcp)
+					{
+						// NODELAY: a PAD is 48 bytes and must not wait for Nagle. KEEPALIVE: a USB
+						// cable pulled mid-session must not leave a half-open controller.
+						const int one = 1;
+						::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+						::setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, sizeof(one));
+					}
+					client nc{fd};
+					nc.since_ns = now;
+					clients.push_back(std::move(nc));
+					pitlink_log.notice("client %d connected", fd);
+				}
+
+				// Read + dispatch, then write
+				for (usz i = 0; i < clients.size() && first_client + i < pfds.size(); i++)
+				{
+					client& c = clients[i];
+					const short rev = pfds[first_client + i].revents;
+
+					// A viewer that stopped reading must not grow without bound (owed frames bypass
+					// the latest-wins gate); a socket that never HELLOs must not hold a seat forever.
+					if (c.fd >= 0 && c.out.size() - c.out_off > (64u << 20))
+					{
+						pitlink_log.warning("client %d: not reading (%u MB queued); dropping it", c.fd, static_cast<u32>((c.out.size() - c.out_off) >> 20));
+						c.fd = -2;
+					}
+					if (c.fd >= 0 && !c.hello && now - c.since_ns > 10'000'000'000ull)
+					{
+						c.fd = -2;
+					}
+
+					if (c.fd >= 0 && (rev & (POLLIN | POLLHUP | POLLERR)))
+					{
+						// Read everything, dispatch everything, THEN honour a hang-up: a client that
+						// sends a PAD and closes (the CLI does) must still have the PAD applied.
+						bool hangup = false;
+						char buf[65536];
+						while (true)
+						{
+							const ssize_t n = ::recv(c.fd, buf, sizeof(buf), 0);
+							if (n > 0)
+							{
+								c.in.append(buf, static_cast<usz>(n));
+								if (c.in.size() > k_max_msg + 16) { hangup = true; break; }
+								continue;
+							}
+							if (n == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) hangup = true;
+							break;
+						}
+
+						usz off = 0;
+						while (c.fd >= 0 && c.in.size() - off >= 16)
+						{
+							reader h{reinterpret_cast<const u8*>(c.in.data() + off), 16};
+							const u32 magic = h.u32_();
+							const u16 type = h.u16_();
+							h.u16_();
+							const u32 seq = h.u32_();
+							const u32 len = h.u32_();
+							if (magic != k_magic || len > k_max_msg) { c.fd = -2; break; }
+							if (c.in.size() - off < 16 + usz{len}) break;
+							on_message(c, clients, type, seq, reinterpret_cast<const u8*>(c.in.data() + off + 16), len);
+							off += 16 + usz{len};
+						}
+						if (c.fd >= 0) c.in.erase(0, off);
+						if (hangup && c.fd >= 0) c.fd = -2;
+					}
+
+					if (c.fd == -2)
+					{
+						// Refusal or hang-up: flush what is queued (best effort), then close.
+						const int fd = pfds[first_client + i].fd;
+						if (c.out_off < c.out.size())
+						{
+							[[maybe_unused]] const auto sent = ::send(fd, c.out.data() + c.out_off, c.out.size() - c.out_off, MSG_NOSIGNAL);
+						}
+						::close(fd);
+						c.fd = -3;
+						continue;
+					}
+
+					if (c.fd >= 0 && c.send_last)
+					{
+						c.send_last = false;
+						if (!last_frame_msg.empty() && c.out_off >= c.frame_end)
+						{
+							c.out += last_frame_msg;
+							c.frame_end = c.out.size();
+						}
+						// ...and the current state and title, which it missed if they changed
+						// before its HELLO (re-sent to everyone: harmless).
+						last_state = ~0u;
+						last_title.clear();
+						title_poll_ns = 0;
+					}
+
+					if (c.fd >= 0 && c.out_off < c.out.size())
+					{
+						const ssize_t n = ::send(c.fd, c.out.data() + c.out_off, c.out.size() - c.out_off, MSG_NOSIGNAL);
+						if (n > 0)
+						{
+							c.out_off += static_cast<usz>(n);
+							if (c.out_off == c.out.size())
+							{
+								c.out.clear();
+								c.out_off = 0;
+								c.frame_end = 0;
+							}
+							else if (c.out_off > (1u << 20))
+							{
+								c.out.erase(0, c.out_off);
+								c.frame_end = c.frame_end > c.out_off ? c.frame_end - c.out_off : 0;
+								c.out_off = 0;
+							}
+						}
+						else if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+						{
+							::close(c.fd);
+							c.fd = -3;
+						}
+					}
+				}
+
+				// Reap closed clients. A controller leaving releases nothing by itself: the pad
+				// dead-man (fed by every PAD) does that within its TTL and says so (EVENT 4), the
+				// same way it covers a link that dies without a FIN. The last viewer stops EYES.
+				for (usz i = 0; i < clients.size();)
+				{
+					if (clients[i].fd >= 0) { i++; continue; }
+					pitlink_log.notice("client disconnected%s", clients[i].controller ? " (controller)" : "");
+					if (clients[i].hello && s.clients.load() > 0) s.clients--;
+					clients.erase(clients.begin() + static_cast<std::ptrdiff_t>(i));
+				}
+			}
+		}
+#endif // PITLINK_SUPPORTED
+	}
+
+	bool enabled()
+	{
+		return conf().enabled;
+	}
+
+	void start()
+	{
+		if (!enabled())
+		{
+			return;
+		}
+
+		std::call_once(st().started, []()
+		{
+#ifdef PITLINK_SUPPORTED
+			st().wake_fd = ::eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+			std::thread(server_main).detach();
+			pitlink_log.success("GTK Pitlink up (video %ux%u@%u, pad %s, ttl %u ms%s%s)",
+				conf().video_w, conf().video_h, conf().video_hz,
+				conf().pad_mode == 0 ? "off" : conf().pad_mode == 2 ? "exclusive" : "merge", conf().ttl_ms,
+				conf().tcp.empty() ? "" : ", tcp ", conf().tcp);
+#else
+			pitlink_log.warning("GTK_PITLINK is set, but Pitlink is Linux-desktop only in this build");
+#endif
+		});
+	}
+
+	void apply_pad(std::shared_ptr<Pad>* pads, usz count)
+	{
+		if (!enabled())
+		{
+			return;
+		}
+
+		auto& s = st();
+		const u64 now = now_ns();
+		const u64 flip = s.flip.load();
+		std::lock_guard lock(s.pad_mtx);
+
+		for (usz port = 0; port < count && port < k_ports; port++)
+		{
+			auto& q = s.pad_sched[port];
+			pad_cmd& cmd = s.pad_now[port];
+			u64& deadline = s.pad_deadline[port];
+
+			// Dead-man: no PAD for TTL -> neutral, schedule dropped. Reported only when that
+			// actually released something (an idle neutral state lapsing is not news).
+			if (deadline && now > deadline)
+			{
+				const bool released = (cmd.active && !is_neutral(cmd)) || !q.empty();
+				cmd = pad_cmd{};
+				q.clear();
+				deadline = 0;
+				if (released)
+				{
+					queue_event(EV_DEADMAN, fmt::format("port %u released: no PAD within its TTL", static_cast<u32>(port)));
+				}
+				continue;
+			}
+
+			// Promote every scheduled state that has come due; the newest due one is live. The
+			// pad thread ticks ~1 kHz against ~30-60 Hz flips, so states stamped for different
+			// flips are each live for their own flips.
+			usz due = 0;
+			while (due < q.size() && q[due].at_flip <= flip)
+			{
+				due++;
+			}
+			if (due)
+			{
+				cmd = q[due - 1];
+				cmd.at_flip = 0;
+				q.erase(q.begin(), q.begin() + static_cast<std::ptrdiff_t>(due));
+			}
+
+			if (!cmd.active)
+			{
+				continue;
+			}
+
+			const auto& pad = pads[port];
+			if (cmd.mode == 0 || !pad || !pad->is_connected())
+			{
+				continue;
+			}
+
+			const bool exclusive = cmd.mode == 2;
+
+			for (ButtonExternal& b : pad->m_buttons_external)
+			{
+				const int bit = button_bit(b.m_offset, b.m_outKeyCode);
+				if (bit < 0)
+				{
+					continue;
+				}
+
+				const bool on = (cmd.buttons >> bit) & 1;
+				const int pi = pressure_index(bit);
+				const u16 value = on ? static_cast<u16>((pi >= 0 && cmd.pressure[pi]) ? cmd.pressure[pi] : 255) : 0;
+
+				if (exclusive)
+				{
+					b.m_pressed = on;
+					b.m_value = value;
+				}
+				else if (on)
+				{
+					// MERGE: the human's pad stays live; the agent adds presses on top.
+					b.m_pressed = true;
+					b.m_value = std::max(b.m_value, value);
+				}
+			}
+
+			for (AnalogStickExternal& stick : pad->m_sticks_external)
+			{
+				u8 v;
+				switch (stick.m_offset)
+				{
+				case CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X: v = cmd.lx; break;
+				case CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y: v = cmd.ly; break;
+				case CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X: v = cmd.rx; break;
+				case CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y: v = cmd.ry; break;
+				default: continue;
+				}
+
+				// MERGE: an agent axis only wins while it is off centre, so the human can always
+				// take the wheel back by letting the agent's axis rest.
+				if (exclusive || v != 128)
+				{
+					stick.m_value = v;
+				}
+			}
+		}
+	}
+
+	void on_flip()
+	{
+		if (!enabled())
+		{
+			return;
+		}
+
+		auto& s = st();
+		const u64 now = now_ns();
+		const u64 prev = s.last_flip_ns.exchange(now);
+		s.flip++;
+
+		if (const auto* renderer = rsx::get_current_renderer())
+		{
+			s.vblank.store(renderer->vblank_count.load());
+		}
+
+		if (prev && now > prev)
+		{
+			const f32 inst = 1e9f / static_cast<f32>(now - prev);
+			const f32 old = s.fps.load();
+			s.fps.store(old > 0.f ? old * 0.9f + inst * 0.1f : inst);
+		}
+
+		u32 left = s.step_left.load();
+		while (left && !s.step_left.compare_exchange_weak(left, left - 1))
+		{
+		}
+
+		if (left == 1)
+		{
+			// Directly, on the RSX thread -- as upstream's own pause-after-N-flips does -- so the
+			// pause lands on this flip instead of 1-2 flips later via the main thread.
+			if (Emu.Pause(false, false))
+			{
+				s.last_flip_ns = 0; // the fps EMA must not average across the pause
+				queue_event(EV_STEP, fmt::format("flip=%u", s.flip.load()));
+			}
+		}
+	}
+
+	frame_ticket want_frame(bool emu_flip)
+	{
+		frame_ticket t;
+		if (!enabled())
+		{
+			return t;
+		}
+
+		auto& s = st();
+		if (!s.clients.load())
+		{
+			return t; // nobody watching: EYES cost nothing
+		}
+
+		const u64 now = now_ns();
+
+		// want_frame runs inside the renderer's flip, before rsx::thread::flip ticks on_flip(),
+		// so step_left == 1 on a game flip means this is the frame the STEP stops on.
+		const bool step_final = emu_flip && s.step_left.load() == 1;
+
+		{
+			std::lock_guard lock(s.video_mtx);
+			if (s.snap_pending)
+			{
+				s.snap_pending = false;
+				t.full = true;
+				if (emu_flip)
+				{
+					s.last_tap_ns = now;
+				}
+			}
+			else if (!emu_flip || !s.vhz)
+			{
+				return t; // native-UI flips only serve a SNAP; vhz 0 = no stream
+			}
+			else if (step_final)
+			{
+				s.last_tap_ns = now;
+			}
+			else
+			{
+				// Rate limit with an eighth of a period of slack, so a 30 Hz tap on a 30 fps
+				// game takes every frame instead of aliasing down to 15.
+				const u64 period = 1'000'000'000ull / s.vhz;
+				if (s.last_tap_ns && now - s.last_tap_ns < period - period / 8)
+				{
+					return t;
+				}
+				s.last_tap_ns = now;
+			}
+			t.width = s.vw;
+			t.height = s.vh;
+		}
+
+		// Read back synchronously when nothing would harvest it otherwise: the frame a STEP
+		// stops on (a paused RSX thread never reaches frame_context_cleanup), or a SNAP served
+		// on a native-UI flip / while paused.
+		t.sync = step_final || (t.full && (!emu_flip || Emu.IsPaused()));
+		t.valid = true;
+		t.flip = s.flip.load() + (emu_flip ? 1 : 0);
+		t.host_ns = now;
+		t.fps = s.fps.load();
+		t.vblank = s.vblank.load();
+
+		// WATCH: sampled here, at the flip, so the frame carries the guest state it was drawn from.
+		std::lock_guard lock(s.watch_mtx);
+		t.watch.assign(s.watch_bytes, 0);
+		usz off = 0;
+		for (const auto& [addr, size] : s.watch)
+		{
+			guest_read(addr, size, t.watch.data() + off); // unreadable -> stays zero
+			off += size;
+		}
+		return t;
+	}
+
+	void requeue(frame_ticket&& ticket)
+	{
+		if (!enabled() || !ticket.full)
+		{
+			return; // a stream frame that found no slot is simply skipped
+		}
+
+		auto& s = st();
+		std::lock_guard lock(s.video_mtx);
+		s.snap_pending = true;
+	}
+
+	void submit_frame(frame_ticket&& ticket, const u8* pixels, u32 width, u32 height, bool is_bgra)
+	{
+		if (!enabled() || !pixels || !width || !height)
+		{
+			return;
+		}
+
+		out_frame f;
+		f.meta = std::move(ticket);
+		f.width = width;
+		f.height = height;
+		f.bgra.assign(pixels, pixels + usz{width} * height * 4);
+
+		if (!is_bgra)
+		{
+			for (usz i = 0; i + 3 < f.bgra.size(); i += 4)
+			{
+				std::swap(f.bgra[i], f.bgra[i + 2]);
+			}
+		}
+
+		auto& s = st();
+		{
+			std::lock_guard lock(s.out_mtx);
+			if (f.meta.full || f.meta.sync)
+			{
+				if (s.owed.size() >= 4)
+				{
+					s.owed.pop_front();
+				}
+				s.owed.push_back(std::move(f));
+			}
+			else
+			{
+				s.frame = std::move(f);
+			}
+		}
+		wake();
+	}
+}
diff --git a/rpcs3/Emu/pitlink/pitlink.h b/rpcs3/Emu/pitlink/pitlink.h
new file mode 100644
index 000000000..515c2a80e
--- /dev/null
+++ b/rpcs3/Emu/pitlink/pitlink.h
@@ -0,0 +1,67 @@
+#pragma once
+
+// GTK Pitlink -- the Engineer's live link into the car (ETK GTK Edition 0.10.0).
+//
+// One server thread inside RPCS3 that gives an external agent the four things it needs to
+// see and drive a game unattended, each at the boundary where the PS3 itself would see it:
+//   EYES    a downscaled copy of every game flip, read back without a GPU stall
+//   HANDS   pad state written at the cellPad boundary (digital bits AND pressure)
+//   MEMORY  guest RAM reads/writes, plus a WATCH list sampled at the flip
+//   CLOCK   pause, step N flips, graceful exit
+// Wire protocol, flags and rationale: ETK docs/PITLINK_SPEC.md (PLNK v1). Everything is
+// gated on GTK_PITLINK=1; with it unset every hook below is a single relaxed load.
+
+#include "util/types.hpp"
+
+#include <memory>
+#include <vector>
+
+struct Pad;
+
+namespace pitlink
+{
+	// GTK_PITLINK=1 in the environment (read once).
+	bool enabled();
+
+	// Idempotent: start the server thread. Emulator::Init runs more than once in a --no-gui
+	// boot, which is how PINE lost its socket; this is a process singleton by construction.
+	void start();
+
+	// HANDS. Called at the end of pad_thread::apply_copilots(), inside its pad::g_pad_mutex
+	// section, on the game-facing copy (m_buttons_external / m_sticks_external) that
+	// cellPadGetData reads -- one lock section, so the game never sees the human-only pad
+	// between the copy and the overlay.
+	void apply_pad(std::shared_ptr<Pad>* pads, usz count);
+
+	// CLOCK. Called by rsx::thread::flip for GAME flips only (info.emu_flip): the flip
+	// counter, the fps EMA and the STEP budget all run off it. Native-UI flips (overlay
+	// refresh, pause screens, the PPU-compile screen) never tick it.
+	void on_flip();
+
+	// EYES. The renderer asks at each flip whether this frame should be tapped; a valid
+	// ticket carries the frame's identity and the WATCH bytes sampled at that flip, and comes
+	// back with the pixels once the frame's own GPU work has retired.
+	struct frame_ticket
+	{
+		bool valid = false;
+		bool full = false;   // native-size SNAP rather than the configured tap size
+		bool sync = false;   // read back now: the frame a STEP stops on, or a SNAP while paused
+		u32 width = 0;       // requested tap size; 0 = native (clamped to the displayed region)
+		u32 height = 0;
+		u64 flip = 0;        // the flip counter's value once this frame's own flip completes
+		u64 vblank = 0;
+		u64 host_ns = 0;     // CLOCK_MONOTONIC at the flip
+		f32 fps = 0.f;
+		std::vector<u8> watch;
+	};
+
+	// emu_flip = rsx::display_flip_info_t::emu_flip. Non-game flips only ever serve a pending
+	// SNAP (that is how a SNAP is answered while the game is paused).
+	frame_ticket want_frame(bool emu_flip);
+
+	// The renderer had no free ring slot for a valid ticket: a SNAP is re-armed, never lost.
+	void requeue(frame_ticket&& ticket);
+
+	// Pixels are tightly packed 8-bit 4-channel; is_bgra=false swizzles from RGBA.
+	void submit_frame(frame_ticket&& ticket, const u8* pixels, u32 width, u32 height, bool is_bgra);
+}
